<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Allows building (not running) on Linux/macOS, e.g. for CI checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AzureSubnetPlanner</AssemblyName>
    <RootNamespace>AzureSubnetPlanner.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>Azure Subnet Planner</Product>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en;nl</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AzureSubnetPlanner.Core\AzureSubnetPlanner.Core.csproj" />
  </ItemGroup>

</Project>
